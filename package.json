{
  "name": "shared-db",
  "version": "1.0.0",
  "description": "Shared database configuration and entities",
  "main": "dist/data-source.js",
  "types": "dist/data-source.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/data-source.d.ts",
      "import": "./dist/data-source.js",
      "require": "./dist/data-source.js",
      "default": "./dist/data-source.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js",
      "require": "./dist/entities/index.js"
    },
    "./entities/*": {
      "types": "./dist/entities/*.d.ts",
      "import": "./dist/entities/*.js",
      "require": "./dist/entities/*.js"
    },
    "./entities/User": {
      "types": "./dist/entities/User.d.ts",
      "import": "./dist/entities/User.js",
      "require": "./dist/entities/User.js"
    },
    "./entities/Video": {
      "types": "./dist/entities/Video.d.ts",
      "import": "./dist/entities/Video.js",
      "require": "./dist/entities/Video.js"
    },
    "./entities/Profile": {
      "types": "./dist/entities/Profile.d.ts",
      "import": "./dist/entities/Profile.js",
      "require": "./dist/entities/Profile.js"
    },
    "./entities/Channel": {
      "types": "./dist/entities/Channel.d.ts",
      "import": "./dist/entities/Channel.js",
      "require": "./dist/entities/Channel.js"
    },
    "./entities/File": {
      "types": "./dist/entities/File.d.ts",
      "import": "./dist/entities/File.js",
      "require": "./dist/entities/File.js"
    },
    "./entities/Usage": {
      "types": "./dist/entities/Usage.d.ts",
      "import": "./dist/entities/Usage.js",
      "require": "./dist/entities/Usage.js"
    },
    "./entities/ApiKey": {
      "types": "./dist/entities/ApiKey.d.ts",
      "import": "./dist/entities/ApiKey.js",
      "require": "./dist/entities/ApiKey.js"
    },
    "./entities/Settings": {
      "types": "./dist/entities/Settings.d.ts",
      "import": "./dist/entities/Settings.js",
      "require": "./dist/entities/Settings.js"
    },
    "./entities/BaseEntity": {
      "types": "./dist/entities/BaseEntity.d.ts",
      "import": "./dist/entities/BaseEntity.js",
      "require": "./dist/entities/BaseEntity.js"
    },
    "./entities/Process": {
      "types": "./dist/entities/Process.d.ts",
      "import": "./dist/entities/Process.js",
      "require": "./dist/entities/Process.js"
    },
    "./entities/ProcessEstimate": {
      "types": "./dist/entities/ProcessEstimate.d.ts",
      "import": "./dist/entities/ProcessEstimate.js",
      "require": "./dist/entities/ProcessEstimate.js"
    },
    "./entities/PerformanceMetrics": {
      "types": "./dist/entities/PerformanceMetrics.d.ts",
      "import": "./dist/entities/PerformanceMetrics.js",
      "require": "./dist/entities/PerformanceMetrics.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js",
      "require": "./dist/types/*.js"
    },
    "./utils/timeline-helpers": {
      "types": "./dist/utils/timeline-helpers.d.ts",
      "import": "./dist/utils/timeline-helpers.js",
      "require": "./dist/utils/timeline-helpers.js"
    },
    "./utils/secure-crypto": {
      "types": "./dist/utils/secure-crypto.d.ts",
      "import": "./dist/utils/secure-crypto.js",
      "require": "./dist/utils/secure-crypto.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.js"
    },
    "./lib/ai-providers": {
      "types": "./dist/lib/ai-providers.d.ts",
      "import": "./dist/lib/ai-providers.js",
      "require": "./dist/lib/ai-providers.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "require": "./dist/lib/*.js"
    },
    "./scripts/check-and-fix-schema": {
      "types": "./dist/scripts/check-and-fix-schema.d.ts",
      "import": "./dist/scripts/check-and-fix-schema.js",
      "require": "./dist/scripts/check-and-fix-schema.js"
    },
    "./scripts/*": {
      "types": "./dist/scripts/*.d.ts",
      "import": "./dist/scripts/*.js",
      "require": "./dist/scripts/*.js"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.6"
  }
}
